# Optional Hugging Face token; public models usually do not require one.
HF_TOKEN=

# Optional LLM labels. Use a key issued by the provider configured below.
# The default endpoint is OpenRouter, so it requires an OpenRouter key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini
